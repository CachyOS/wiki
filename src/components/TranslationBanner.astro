---
const locales = ['cs', 'de', 'el', 'es', 'fr', 'ja', 'pl', 'ru', 'sk', 'pt', 'bg'];
const rawDocs = import.meta.glob('/src/content/docs/(cs|de|el|es|fr|ja|pl|ru|sk|pt|bg)/**/*.{md,mdx}', { query: '?raw', import: 'default', eager: true });

const segments = Astro.url.pathname.split('/').filter(Boolean);
const locale = segments[0];
const isTranslated = locales.includes(locale);

if (!isTranslated) return null;

const slug = segments.slice(1).join('/') || 'index';
const raw = rawDocs[`/src/content/docs/${locale}/${slug}.mdx`] ?? rawDocs[`/src/content/docs/${locale}/${slug}.md`];
let ai = false;
if (raw) {
  const fm = raw.match(/^---\n([\s\S]*?)\n---/);
  if (fm?.[1].includes('ai_translated')) ai = true;
}
---

<div id="translation-banner" class="sl-banner">
  <div class="sl-banner-content">
    <strong>Translation notice</strong>
    <p>This is a community-maintained translation. The English version is the authoritative source.</p>
    {ai && (
      <p>This page was translated using generative AI and may not yet have been reviewed by a native speaker.</p>
    )}
    <p>Found an error? Please open an issue or submit a correction. Community contributions help us keep translations accurate and up to date.</p>
  </div>
  <button
    type="button"
    class="sl-dismiss-btn"
    aria-label="Dismiss banner"
    onclick="sessionStorage.setItem('banner_dismissed','true');document.getElementById('translation-banner').style.display='none';"
  >×</button>
</div>

<style>
  .sl-banner {
    background-color: var(--sl-color-bg);
    border-bottom: 1px solid var(--sl-color-gray-5);
    padding: 1rem 4rem 1rem 1.5rem;
    margin: 0;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--sl-color-text);
    position: sticky;
    top: var(--sl-nav-height);
    z-index: 100;
  }
  .sl-banner-content {
    max-width: 90%;
  }
  .sl-banner-content strong {
    display: block;
    font-weight: 600;
    margin-bottom: 0.25rem;
    color: var(--sl-color-accent);
  }
  .sl-banner-content p {
    margin: 0.25rem 0;
    line-height: 1.5;
  }
  .sl-banner-content p:first-child {
    margin-top: 0;
  }

  .sl-dismiss-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: none;
    border: none;
    color: var(--sl-color-text-muted);
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    opacity: 0.6;
    transition: opacity 0.15s;
    padding: 0.25rem;
  }
  .sl-dismiss-btn:hover {
    opacity: 1;
  }
</style>

<script>
  if (sessionStorage.getItem('banner_dismissed') === 'true') {
    const banner = document.getElementById('translation-banner');
    if (banner) banner.style.display = 'none';
  }
</script>