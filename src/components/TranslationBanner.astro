---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import DefaultBanner from '@astrojs/starlight/components/Banner.astro';
import { LinkButton } from '@astrojs/starlight/components';
import lunariaConfig from '../../lunaria.config.json';

const { locale, entry, isFallback } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;
const isSpecialPath =
  pathname.startsWith('/localization') ||
  pathname.startsWith('/404') ||
  entry.id === '404' ||
  entry.id.endsWith('/404');

// 1. Starlight standard outdated banner (cyan)
const hasOutdatedBanner = !!entry.data.banner;

// 2. Non-English community translation notice
const isNonEnglish = Boolean(locale) && !isFallback;
const aiTranslated = entry.data.ai_translated;
const transTitle = isNonEnglish ? Astro.locals.t('banner.translationNotice.title') : '';
const transLine1 = isNonEnglish ? Astro.locals.t('banner.translationNotice.line1') : '';
const transLine2 = isNonEnglish ? Astro.locals.t('banner.translationNotice.line2') : '';
const transLine3 = isNonEnglish ? Astro.locals.t('banner.translationNotice.line3') : '';

// 3. English root page language switch banner
const isRoot = !locale && !isFallback && !isSpecialPath;
const filePath = entry.filePath;
const docsPrefix = 'src/content/docs/';
const relativePath = filePath.startsWith(docsPrefix) ? filePath.slice(docsPrefix.length) : filePath;

function checkTranslationExists(lang: string, relPath: string): boolean {
  if (!relPath) return false;
  const base = path.join(process.cwd(), 'src/content/docs', lang, relPath);
  if (fs.existsSync(base)) return true;
  if (base.endsWith('.mdx') && fs.existsSync(base.slice(0, -4) + '.md')) return true;
  if (base.endsWith('.md') && fs.existsSync(base.slice(0, -3) + '.mdx')) return true;
  return false;
}

interface AvailableTranslation {
  url: string;
  label: string;
  title: string;
  message: string;
  button: string;
  hintDesktop: string;
  hintMobile: string;
}

const availableTranslations: Record<string, AvailableTranslation> = {};
let defaultButton = 'Switch to English version';

if (isRoot && relativePath) {
  const i18nEntries = await getCollection('i18n');
  const i18nMap = new Map(i18nEntries.map((e) => [e.id, e.data]));

  const enI18n = i18nMap.get('en');
  const defaultTitle = enI18n?.['banner.translationAvailable.title'] ?? 'Translation available';
  const defaultMessage =
    enI18n?.['banner.translationAvailable.message'] ??
    'This page is available in English. Do you want to switch to the translated version?';
  defaultButton = enI18n?.['banner.translationAvailable.button'] ?? 'Switch to English version';
  const defaultHintDesktop =
    enI18n?.['banner.translationAvailable.hintDesktop'] ??
    'Even if you dismiss this banner, you can manually switch languages from the selector at the top right.';
  const defaultHintMobile =
    enI18n?.['banner.translationAvailable.hintMobile'] ??
    'Even if you dismiss this banner, you can manually switch languages from the ≡ menu at the top right.';

  for (const localeConfig of lunariaConfig.locales) {
    const lang = localeConfig.lang;
    if (checkTranslationExists(lang, relativePath)) {
      const targetUrl = pathname === '/' ? `/${lang}/` : `/${lang}${pathname}`;
      const langI18n = i18nMap.get(lang);
      const title = langI18n?.['banner.translationAvailable.title'] ?? defaultTitle;
      const message = langI18n?.['banner.translationAvailable.message'] ?? defaultMessage;
      const button = langI18n?.['banner.translationAvailable.button'] ?? defaultButton;
      const hintDesktop =
        langI18n?.['banner.translationAvailable.hintDesktop'] ?? defaultHintDesktop;
      const hintMobile = langI18n?.['banner.translationAvailable.hintMobile'] ?? defaultHintMobile;

      availableTranslations[lang] = {
        url: targetUrl,
        label: localeConfig.label,
        title,
        message,
        button,
        hintDesktop,
        hintMobile,
      };
    }
  }
}

const hasSwitchTranslations = Object.keys(availableTranslations).length > 0;
---

{hasOutdatedBanner && <DefaultBanner />}

{
  isNonEnglish && (
    <div
      id="translation-banner"
      class="sl-banner-wrapper"
      data-pagefind-ignore
      lang={locale}
      data-ai={String(aiTranslated)}
      style="display: none;"
    >
      <div class="sl-banner-content">
        <strong>{transTitle}</strong>
        <p>{transLine1}</p>
        {aiTranslated && <p>{transLine2}</p>}
        <p>{transLine3}</p>
      </div>
      <button
        type="button"
        class="sl-dismiss-btn"
        aria-label="Dismiss banner"
        id="translation-banner-dismiss-btn"
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
  )
}

{
  isRoot && hasSwitchTranslations && (
    <div
      id="switch-lang-banner"
      class="sl-banner-wrapper"
      data-pagefind-ignore
      data-translations={JSON.stringify(availableTranslations)}
      style="display: none;"
    >
      <div class="sl-banner-content sl-switch-layout">
        <div class="sl-switch-text">
          <strong id="switch-lang-title" />
          <p id="switch-lang-message" />
          <p>
            <span class="sl-switch-hint-desktop" id="switch-lang-hint-desktop" />
            <span class="sl-switch-hint-mobile" id="switch-lang-hint-mobile" />
          </p>
        </div>
        <div class="sl-switch-actions">
          <LinkButton href="#" id="switch-lang-btn" variant="primary">
            {defaultButton}
          </LinkButton>
        </div>
      </div>
      <button
        type="button"
        class="sl-dismiss-btn"
        aria-label="Dismiss banner"
        id="switch-lang-dismiss-btn"
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
  )
}

<style>
  .sl-banner-wrapper {
    position: relative;
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    background-color: var(--sl-color-bg);
    border-bottom: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-text);
    font-size: var(--sl-text-xs);
  }
  .sl-banner-content {
    max-width: 90%;
  }
  .sl-banner-content strong {
    display: block;
    font-weight: 600;
    margin-bottom: 0.25rem;
    color: var(--sl-color-accent);
    line-height: var(--sl-line-height-headings);
  }
  .sl-banner-content p {
    margin: 0.25rem 0;
    line-height: 1.5;
  }
  .sl-switch-layout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: calc(100% - 2.5rem);
    width: 100%;
  }
  .sl-switch-text {
    flex: 1 1 auto;
    min-width: 0;
  }
  .sl-switch-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .sl-switch-actions :global(.sl-link-button) {
    white-space: nowrap;
    cursor: pointer;
  }
  .sl-switch-hint-desktop {
    display: none;
  }
  .sl-switch-hint-mobile {
    display: inline;
  }
  @media (min-width: 50rem) {
    .sl-switch-hint-desktop {
      display: inline;
    }
    .sl-switch-hint-mobile {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .sl-switch-layout {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .sl-switch-actions {
      width: 100%;
    }
    .sl-switch-actions :global(.sl-link-button) {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }
  .sl-dismiss-btn {
    position: absolute;
    top: 0.5rem;
    inset-inline-end: 0.5rem;
    background: none;
    border: none;
    color: var(--sl-color-text-muted);
    cursor: pointer;
    font-size: 1.5rem;
    line-height: 1;
    opacity: 0.6;
    transition: opacity 0.15s;
    padding: 0.25rem;
  }
  .sl-dismiss-btn:hover {
    opacity: 1;
  }
</style>

<script is:inline>
  (function () {
    try {
      // 1. Translation notice banner logic
      const transBanner = document.getElementById('translation-banner');
      if (transBanner) {
        const ai = transBanner.dataset.ai === 'true';
        const transKey = 'banner_dismissed_translation_' + (ai ? 'ai' : 'manual');
        if (!sessionStorage.getItem(transKey)) {
          transBanner.style.display = '';
        }
        const transDismissBtn = document.getElementById('translation-banner-dismiss-btn');
        if (transDismissBtn) {
          transDismissBtn.onclick = function () {
            try {
              sessionStorage.setItem(transKey, 'true');
            } catch (e) {}
            transBanner.style.display = 'none';
          };
        }
      }

      // 2. Language switch banner logic
      const switchBanner = document.getElementById('switch-lang-banner');
      if (switchBanner) {
        const switchDismissKey = 'banner_dismissed_switch_lang';
        if (!sessionStorage.getItem(switchDismissKey)) {
          const translationsData = switchBanner.getAttribute('data-translations');
          if (translationsData) {
            const available = JSON.parse(translationsData);
            const navLangs =
              navigator.languages && navigator.languages.length > 0
                ? navigator.languages
                : navigator.language
                  ? [navigator.language]
                  : [];
            let matchedLang = null;

            for (let i = 0; i < navLangs.length; i++) {
              const langStr = (navLangs[i] || '').toLowerCase();
              const code = langStr.split('-')[0];
              if (!code) continue;
              if (code === 'en') break;
              if (available[code]) {
                matchedLang = code;
                break;
              }
            }

            if (matchedLang && available[matchedLang]) {
              const target = available[matchedLang];
              const titleEl = document.getElementById('switch-lang-title');
              const messageEl = document.getElementById('switch-lang-message');
              const hintDesktopEl = document.getElementById('switch-lang-hint-desktop');
              const hintMobileEl = document.getElementById('switch-lang-hint-mobile');
              const btnEl = document.getElementById('switch-lang-btn');
              const switchDismissBtn = document.getElementById('switch-lang-dismiss-btn');

              if (titleEl) titleEl.textContent = target.title;
              if (messageEl) messageEl.textContent = target.message;
              if (hintDesktopEl && target.hintDesktop)
                hintDesktopEl.textContent = target.hintDesktop;
              if (hintMobileEl && target.hintMobile) hintMobileEl.textContent = target.hintMobile;
              if (btnEl) {
                btnEl.textContent = target.button;
                const targetUrl = target.url + window.location.search + window.location.hash;
                btnEl.setAttribute('href', targetUrl);
                btnEl.onclick = function () {
                  try {
                    sessionStorage.setItem('starlight-lang-redirected', 'true');
                    localStorage.setItem('preferred_locale', matchedLang);
                  } catch (e) {}
                };
              }
              if (switchDismissBtn) {
                switchDismissBtn.onclick = function () {
                  try {
                    sessionStorage.setItem(switchDismissKey, 'true');
                  } catch (e) {}
                  switchBanner.style.display = 'none';
                };
              }
              switchBanner.style.display = '';
            }
          }
        }
      }
    } catch (err) {
      console.error('Error initializing banners:', err);
    }
  })();
</script>
